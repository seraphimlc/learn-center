# Copy to .env and fill. Never commit .env
LLM_BASE_URL=https://api.xytoken.xyb2b.com/v1
LLM_API_KEY=
LLM_MODEL=Aerith-sonnet-5.5
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=./uploads

# WeChat Open Platform website app (扫码登录). Leave empty to disable gracefully.
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://learn.visitworld.me/login/wechat/callback
# Optional 公众号网页授权
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# Set false to disable public password reset (admin reset only)
PUBLIC_RESET_ENABLED=true
RL_AUTH_PER_MIN=30
RL_RESET_PER_MIN=10

# Playback progress Redis TTL (days); heartbeats never flush MySQL
PROGRESS_TTL_DAYS=14
PROGRESS_ASYNC_ENABLED=true

# Public content Redis cache TTLs (seconds)
CACHE_HOME_TTL=30
CACHE_CATEGORY_TTL=60
CACHE_COURSE_LIST_TTL=30
CACHE_COURSE_DETAIL_TTL=60
CACHE_SITE_CONFIG_TTL=120
CACHE_NEWS_LIST_TTL=30
CACHE_ENTITY_TTL=60

# Aliyun OSS (private bucket + signed GET). Leave OSS_ENABLED=false for local uploads/.
OSS_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# Shared-bucket isolation; videos → learn/videos/…, images → learn/images/…
OSS_PREFIX=learn/
# CDN in front of OSS — keep false until CDN_DOMAIN is provisioned
CDN_ENABLED=false
CDN_DOMAIN=
# Short-lived play URL TTL (seconds)
MEDIA_SIGNED_TTL=900
